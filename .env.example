# Copia a .env y completa. Nunca commitees .env. En producción los valores vienen de Secrets Manager (ADR-0005).
DATABASE_URL=postgresql://app:<contraseña>@localhost:5432/booking
# Mínimo 32 caracteres aleatorios: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BUSINESS_NAME=Negocio de ejemplo
# Identificador IANA
BUSINESS_TIMEZONE=America/Bogota
# #RRGGBB con contraste mínimo 4,5:1 sobre blanco
BRAND_PRIMARY_COLOR=#1d4ed8
# smtp (local, Mailpit) | ses (AWS)
EMAIL_TRANSPORT=smtp
EMAIL_FROM=reservas@example.com
SMTP_URL=smtp://localhost:1025
# Solo con EMAIL_TRANSPORT=ses
AWS_REGION=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
