#!/bin/sh
# Fast local feedback: repository rules plus only the change records this commit touches.
# CI re-runs every change record and is the authoritative gate. Use `sdlc check` for the full run.
# threat-model T-14: secretos bloqueados antes de entrar al historial.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks no está instalado (brew install gitleaks)." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner . || exit 1
exec python3 .harness/sdlc.pyz check --staged
