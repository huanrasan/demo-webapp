        </mxCell>

        <!-- Leyenda -->
        <mxCell id="legend" value="&lt;b&gt;Flujos&lt;/b&gt; (misma numeración que design.md §Flujos de despliegue)&lt;br&gt;1 Navegador resuelve el dominio en Route 53.&lt;br&gt;2 Navegador → ALB por HTTPS 443 (TLS 1.2+, certificado ACM; 80 redirige a 443).&lt;br&gt;3 ALB → tarea web por HTTP 3000 (SG web solo acepta desde SG alb; SG worker sin entrantes); healthcheck GET /api/health.&lt;br&gt;4 web → RDS 5432 con TLS (usuario app, DML; SG rds solo desde SG web/worker/migrate).&lt;br&gt;5 worker → RDS 5432 con TLS (usuario app; cola pg-boss en esquema pgboss).&lt;br&gt;6 migrate → RDS 5432 con TLS (usuario migrator, DDL), antes de cada despliegue.&lt;br&gt;7 web/worker → SES API (HTTPS, rol IAM de la tarea): enlaces mágicos, confirmaciones, recordatorios." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#AAB7B8;fillColor=#ffffff;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="220" y="1030" width="640" height="190" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="8 ECS inyecta secretos de Secrets Manager al arrancar web, worker y migrate.&lt;br&gt;9 web/worker/migrate → CloudWatch Logs y métricas (awslogs, Embedded Metric Format).&lt;br&gt;10 ECS descarga la imagen desde ECR al lanzar tareas.&lt;br&gt;11 SES entrega el email al buzón del cliente (sin nombre de servicio).&lt;br&gt;12 GitHub Actions (OIDC, sin claves) publica la imagen en ECR.&lt;br&gt;13 (interno de GitHub Actions → ECS) ejecuta migrate y actualiza servicios web/worker; sin arista para no cruzar el lienzo.&lt;br&gt;&lt;br&gt;Corredor grueso 7/8/9/10: salida a internet por IP pública de las tareas vía Internet Gateway (sin NAT Gateway).&lt;br&gt;Líneas discontinuas desde el Internet Gateway: fan-out a cada servicio regional." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;strokeColor=#AAB7B8;fillColor=#ffffff;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="1030" width="660" height="190" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
